# Leave these unset for local dev — a local SQLite file (data/food.db) and
# data/uploads are used instead. Both are required on Vercel.

# Turso: `turso db show <name> --url` and `turso db tokens create <name>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob: created automatically when you connect a Blob store to the project
BLOB_READ_WRITE_TOKEN=
